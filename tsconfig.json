{
	"extends": "astro/tsconfigs/strict",
	"compilerOptions": {
		"target": "esnext",
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"types": ["node"],
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"erasableSyntaxOnly": true,
		"verbatimModuleSyntax": true,
		"noUncheckedIndexedAccess": true,
		"skipLibCheck": true,
		"customConditions": ["kaiten-dev"]
	},
	"include": [".astro/types.d.ts", "src", "*.mjs", "*.js"],
	"exclude": ["build", "src/**/*.e2e.ts"]
}
