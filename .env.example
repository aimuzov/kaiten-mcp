# Локальный stdio-сервер берёт настройки из окружения или из .env рядом с запуском.
# Удалённый коннектор (`kaiten-mcp serve --http`) на сервере читает /srv/kaiten-mcp/.env.

# Адрес Kaiten, /api/latest можно не писать. Для stdio без него сервер спросит адрес
# через elicitation. Для коннектора он задаёт один адрес для всех, иначе его вводят при входе.
KAITEN_API_URL=https://your-domain.kaiten.ru

# API-токен Kaiten для stdio: профиль -> API-ключи. Без него сервер спросит через elicitation.
# Коннектору не нужен: каждый входит своим токеном.
# KAITEN_API_TOKEN=

# Необязательные настройки.
# KAITEN_DEFAULT_SPACE_ID=
# KAITEN_REQUEST_TIMEOUT_MS=30000
# KAITEN_MAX_CONCURRENT_REQUESTS=5
# KAITEN_LOG_LEVEL=info
# KAITEN_LOG_FILE=
# Ошибки в Sentry. Без DSN SDK не стартует, локально его не задают.
# SENTRY_DSN=

# Только для коннектора.
# Публичный адрес.
# PUBLIC_URL=https://kaiten-mcp.aimuzov.online
# Шифрует токены доступа, в которых едет токен Kaiten. От 32 символов: openssl rand -hex 32.
# Смена разлогинит всех.
# AUTH_SECRET=
# Колбэки сверх Claude и loopback, через запятую.
# ALLOWED_REDIRECT_URIS=
