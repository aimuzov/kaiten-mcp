{
	"name": "@aimuzov/kaiten-mcp",
	"version": "1.0.0",
	"description": "MCP server for Kaiten: spaces, boards, cards, comments, checklists, time tracking and day planning from any MCP client, over stdio or as a hosted connector",
	"keywords": [
		"kaiten",
		"mcp",
		"model-context-protocol",
		"mcp-server",
		"claude",
		"claude-desktop",
		"claude-code",
		"cowork",
		"ai",
		"llm",
		"stdio",
		"kanban",
		"project-management",
		"task-management"
	],
	"homepage": "https://github.com/aimuzov/kaiten-mcp#readme",
	"bugs": {
		"url": "https://github.com/aimuzov/kaiten-mcp/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/aimuzov/kaiten-mcp.git"
	},
	"license": "MIT",
	"author": "Aleksey Imuzov",
	"type": "module",
	"bin": {
		"kaiten-mcp": "build/index.js"
	},
	"files": [
		"build",
		"README.md",
		"README.ru.md",
		".env.example",
		".mcp.json.example"
	],
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"engines": {
		"node": ">=26"
	},
	"scripts": {
		"start": "node --conditions=kaiten-dev src/index.ts",
		"build": "rm -rf build && tsc -p tsconfig.build.json && chmod +x build/index.js",
		"typecheck": "tsc",
		"test": "node --conditions=kaiten-dev --test 'src/**/*.test.ts'",
		"format": "oxlint --fix && prettier --write .",
		"format:check": "prettier --check .",
		"lint": "oxlint --deny-warnings",
		"prepack": "npm run build"
	},
	"dependencies": {
		"@aimuzov/infra-mcp-kit": "github:aimuzov/infra-mcp-kit#v1.0.3",
		"@modelcontextprotocol/sdk": "1.32.1",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@aimuzov/infra-site-kit": "github:aimuzov/infra-site-kit#v4.0.0",
		"@types/node": "26.6.5",
		"oxlint": "1.87.0",
		"prettier": "3.9.9",
		"typescript": "6.0.3"
	},
	"imports": {
		"#kaiten/*": {
			"kaiten-dev": "./src/*.ts",
			"default": "./build/*.js"
		}
	}
}
