---
import { localeOfPath } from '@aimuzov/infra-site-kit/i18n.js'

import Layout from '@aimuzov/infra-mcp-kit/astro/layout.astro'
import { localePaths, pt } from '@aimuzov/infra-mcp-kit/astro/lib/i18n.ts'

// Подчёркивание убирает остров из маршрутов, а соседство -- `../` из импорта.
import Login from './_login.svelte'

// `/login` и `/en/login`: кит редиректит на страницу входа на языке человека.
export const getStaticPaths = localePaths

const locale = localeOfPath(Astro.url.pathname)
---

<Layout title={pt(locale, 'login.title', { service: 'kaiten' })} screen="token">
	<Login client:load {locale} />
</Layout>
